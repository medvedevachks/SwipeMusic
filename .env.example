# Spotify Web API (PKCE — без client secret)
# Создайте приложение: https://developer.spotify.com/dashboard
# Redirect URI: http://localhost:5173/sources (или ваш origin + /sources)
VITE_SPOTIFY_CLIENT_ID=
# Опционально (по умолчанию: {origin}/sources)
# VITE_SPOTIFY_REDIRECT_URI=http://localhost:5173/sources

# Auth backend (server/index.ts). Секретов здесь нет.
NODE_ENV=development
PORT=8787
DATABASE_PATH=.data/swipemusic.sqlite
APP_PUBLIC_URL=http://127.0.0.1:5173

# console — только development. В production нужен smtp.
# rate limit хранится в памяти процесса и сбрасывается после перезапуска сервера.
MAIL_TRANSPORT=console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
