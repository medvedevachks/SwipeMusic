# Скопируйте в .env и замените значения. Файл .env не коммитится.

POSTGRES_DB=swipe_music
POSTGRES_TEST_DB=swipe_music_test
POSTGRES_MIGRATE_USER=swipe
POSTGRES_MIGRATE_PASSWORD=change_me_db_password
POSTGRES_APP_USER=swipe_app
POSTGRES_APP_PASSWORD=change_me_app_password

# Минимум 32 символа
BETTER_AUTH_SECRET=replace_with_a_long_random_secret_32plus

# Публичный адрес, который открывает браузер (не Docker DNS)
APP_ORIGIN=http://localhost:5173
FRONTEND_PORT=5173
MAILPIT_UI_PORT=8025

SMTP_FROM=Swipe Music <noreply@localhost>

# Будущий официальный ключ Zaycev.net. Сейчас не используется (режим B, без API).
# ZAYCEV_PARTNER_KEY=

# Будущий официальный client_id Яндекс Музыки. Сейчас не используется.
# YANDEX_MUSIC_CLIENT_ID=

# Production SMTP (compose.prod.yaml). Пока не задан — реальная почта не уйдёт.
# SMTP_HOST=smtp.example.ru
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=true
