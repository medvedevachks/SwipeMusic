# Шаблон production-окружения. Не коммитить заполненный файл.
# Значения в угловых скобках нужно заменить. Это не настоящие секреты.

NODE_ENV=production
PORT=8787
DATABASE_PATH=C:\SwipeMusic\data\swipemusic.sqlite
APP_PUBLIC_URL=https://<PUBLIC_IP>
# Доверенный origin state-changing запросов: origin APP_PUBLIC_URL
# и https://app.swipe-music.site. Дополнительные origin только полным списком,
# без wildcard. Пример: APP_ALLOWED_ORIGINS=https://203.0.113.5

# 32 байта в base64. Сгенерировать локально и никуда не коммитить:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PROVIDER_SESSION_KEY=<BASE64_32_BYTE_KEY>

MAIL_TRANSPORT=smtp
SMTP_HOST=<SMTP_HOST>
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<SMTP_USER>
SMTP_PASSWORD=<SMTP_PASSWORD>
SMTP_FROM=<SMTP_FROM>
