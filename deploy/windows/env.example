# Шаблон production-окружения. Не коммитить заполненный файл.
# Значения в угловых скобках нужно заменить. Это не настоящие секреты.

NODE_ENV=production
PORT=8787
DATABASE_PATH=C:\SwipeMusic\data\swipemusic.sqlite
APP_PUBLIC_URL=https://app.swipe-music.site
# Этот URL уже входит в доверенные origin вместе с https://app.swipe-music.site.
# APP_ALLOWED_ORIGINS нужен только для других точных origin, без wildcard.

# 32 байта в base64. Сгенерировать локально и никуда не коммитить:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PROVIDER_SESSION_KEY=<BASE64_32_BYTE_KEY>

MAIL_TRANSPORT=smtp
SMTP_HOST=<SMTP_HOST>
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<SMTP_USER>
SMTP_PASSWORD=<SMTP_PASSWORD>
SMTP_FROM=<SMTP_FROM>
