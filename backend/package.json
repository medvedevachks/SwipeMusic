    "nodemailer": "^7.0.11",
    "postgres": "^3.4.8",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^7.0.4",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
